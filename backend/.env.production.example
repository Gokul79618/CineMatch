APP_NAME=CineMatch AI
APP_VERSION=0.1.0
API_VERSION=v1
APP_ENV=production
APP_AUTO_INIT_DB=false
MYSQL_HOST=private-mysql.internal
MYSQL_PORT=3306
MYSQL_CONNECT_TIMEOUT_SECONDS=10
MYSQL_USER=cinematch_app
MYSQL_PASSWORD=replace-with-secret-manager-value
MYSQL_DATABASE=cinematch_db
MYSQL_TEST_DATABASE=cinematch_test_db
MYSQL_SSL_CA=/run/secrets/mysql-ca.pem
MYSQL_SSL_VERIFY_CERT=true
MOVIES_CATALOG_PATH=data/movies.json
RAG_DOCUMENTS_PATH=data/rag_documents.json
RAG_INDEX_PATH=data/rag_index.json
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_DEFAULT_TOP_K=3
RAG_MINIMUM_SIMILARITY=0.30
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=1
FRONTEND_ORIGINS=https://app.example.com
MAX_REQUEST_BYTES=1048576
AGENT_REQUESTS_PER_MINUTE=20
